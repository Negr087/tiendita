// Tiendita — schema
// Decisión de diseño: PostgreSQL en producción (Vercel Postgres / Neon).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USERS — el comerciante. Su identidad ES su npub Nostr (NIP-07).
// No guardamos passwords. No hay registro tradicional. Soberanía de keys.
// ============================================================================
model User {
  id               String   @id @default(cuid())
  npub             String   @unique // identidad Nostr — clave primaria semántica
  displayName      String?
  about            String?
  avatarUrl        String?

  // Tienda
  slug             String   @unique // tiendita.app/{slug}
  shopName         String
  shopDescription  String?
  shopAccent       String   @default("#FFD400") // color de acento de la tienda

  // Pagos
  lightningAddress String   // ej: juan@walletofsatoshi.com — recibe sats acá
  wapuAlias        String?  // alias o CBU para offramp ARS automático
  wapuReceiverName String?  // nombre titular de la cuenta

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products         Product[]
  orders           Order[]
}

// ============================================================================
// PRODUCTS — one-shot o subscription.
// ============================================================================
model Product {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  imageUrl      String?
  priceArs      Int      // en pesos enteros, sin decimales

  type          String   @default("ONE_SHOT") // ONE_SHOT | SUBSCRIPTION
  intervalDays  Int?     // solo si type = SUBSCRIPTION (7, 30, 90...)

  active        Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders        Order[]
  subscriptions Subscription[]

  @@index([userId])
}

// ============================================================================
// ORDERS — cada compra.
// ============================================================================
model Order {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  userId          String   // denormalizado para queries del dashboard
  user            User     @relation(fields: [userId], references: [id])

  buyerNpub       String?
  buyerEmail      String?
  buyerLabel      String?

  // Lightning
  invoiceBolt11   String   @unique
  paymentHash     String   @unique
  status          String   @default("PENDING") // PENDING | PAID | EXPIRED | CANCELLED
  amountSats      Int
  amountArs       Int      // snapshot del precio en ARS al momento de invoice
  btcArsRate      Float    // tasa usada (para auditar)

  // Subscription tracking
  subscriptionId  String?
  cycleNumber     Int?

  // Wapu offramp
  wapuDepositId   String?  // ID del depósito en Wapu
  wapuTxId        String?  // ID de la operación de retiro ARS
  wapuStatus      String?  // PENDING | SENT | FAILED | NOT_CONFIGURED

  // Verificación de pago (LUD-21)
  verifyUrl       String?

  createdAt       DateTime @default(now())
  paidAt          DateTime?
  expiresAt       DateTime

  @@index([userId])
  @@index([status])
  @@index([subscriptionId])
}

// ============================================================================
// SUBSCRIPTIONS — el diferenciador del proyecto.
// ============================================================================
model Subscription {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  buyerNpub     String?
  buyerEmail    String?
  buyerLabel    String?

  status        String   @default("ACTIVE") // ACTIVE | PAST_DUE | CANCELLED | ENDED
  intervalDays  Int      // copia denormalizada de Product.intervalDays
  nextBillingAt DateTime
  cycleCount    Int      @default(1)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  cancelledAt   DateTime?

  @@index([status, nextBillingAt])
}

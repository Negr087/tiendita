// Tiendita — schema
// PostgreSQL (Neon) para producción. Enums reemplazados por String para compatibilidad.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USERS — el comerciante. Su identidad ES su npub Nostr (NIP-07).
// No guardamos passwords. No hay registro tradicional. Soberanía de keys.
// ============================================================================
model User {
  id               String   @id @default(cuid())
  npub             String   @unique // identidad Nostr — clave primaria semántica
  displayName      String?
  about            String?
  avatarUrl        String?

  // Tienda
  slug             String   @unique // tiendita.app/{slug}
  shopName         String
  shopDescription  String?
  shopAccent       String   @default("#FFD400") // color de acento de la tienda

  // Pagos
  lightningAddress String   // ej: juan@walletofsatoshi.com — recibe sats acá
  wapuAlias        String?  // alias o CBU para offramp ARS automático
  wapuReceiverName String?  // nombre titular de la cuenta

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products         Product[]
  orders           Order[]
}

// ============================================================================
// PRODUCTS — lo que vende el comerciante. Pago único.
// ============================================================================
model Product {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  imageUrl      String?
  priceArs      Int      // en pesos enteros, sin decimales
  deliveryInfo  String?  // se muestra al comprador SOLO después de pagar (link de descarga, instrucciones de retiro…)

  active        Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders        Order[]

  @@index([userId])
}

// ============================================================================
// ORDERS — cada compra.
// ============================================================================
model Order {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  userId          String   // denormalizado para queries del dashboard
  user            User     @relation(fields: [userId], references: [id])

  buyerNpub       String?  // opcional: si el comprador se logueó con Nostr
  buyerEmail      String?  // opcional: contacto del comprador
  buyerLabel      String?  // nombre visible del comprador
  buyerContact    String?  // WhatsApp, email o dirección de entrega

  // Lightning
  invoiceBolt11   String   @unique
  paymentHash     String   @unique
  verifyUrl       String?  // LUD-21: URL para verificar pago
  status          String   @default("PENDING")  // PENDING | PAID | EXPIRED | CANCELLED
  amountSats      Int
  amountArs       Int      // snapshot del precio en ARS al momento de invoice
  btcArsRate      Float    // tasa usada (para auditar)

  // Wapu offramp
  wapuTxId        String?  // ID de la operación de retiro ARS
  wapuDepositId   String?  // ID del depósito Wapu
  wapuStatus      String?  // PENDING | SENT | FAILED

  createdAt       DateTime @default(now())
  paidAt          DateTime?
  expiresAt       DateTime

  @@index([userId])
  @@index([status])
}

# ============================================================================
# Mostrador — variables de entorno
# Copiá este archivo a .env y completá los valores
# ============================================================================

# Database
DATABASE_URL="file:./dev.db"

# Sesión (iron-session) — generá uno con: openssl rand -base64 32
SESSION_SECRET="cambiame-por-32-chars-aleatorios-en-produccion-please"

# URL pública de la app (para callbacks, OG tags, etc)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================================
# Wapu API — offramp Lightning -> ARS
# Obtené tu API key en https://wapu.shiafu.com
# Para hackathon podés usar el CLI directamente sin API key
# ============================================================================
WAPU_API_URL="https://api.wapu.shiafu.com"
WAPU_API_KEY=""

# Modo de Wapu: "real" usa la API, "mock" simula los retiros (para demo segura)
WAPU_MODE="mock"

# ============================================================================
# Tasa BTC/ARS — fuente de precio
# Yadio es gratis y sin API key. Buena para Argentina.
# ============================================================================
PRICE_FEED_URL="https://api.yadio.io/exrates/BTC"

# ============================================================================
# Modo demo — acelera los ciclos de suscripción para que el jurado vea todo en vivo
# Cuando está en true, "intervalDays" se interpreta como "intervalSeconds * 30"
# Ej: producto de 7 días → renueva cada 7 minutos (30s * 7 = 3.5 min escalado)
# ============================================================================
DEMO_MODE="true"
DEMO_INTERVAL_MULTIPLIER_SECONDS="30"

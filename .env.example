# ============================================================================
# Tiendita — variables de entorno
# Copiá este archivo a .env y completá los valores
# ============================================================================

# Database (PostgreSQL, ej: Neon)
DATABASE_URL="postgresql://usuario:password@host/tiendita?sslmode=require"

# Sesión (iron-session) — OBLIGATORIO en producción, mínimo 32 caracteres.
# Generá uno con: openssl rand -base64 32
SESSION_SECRET=""

# URL pública de la app (para callbacks, OG tags, etc)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================================
# Wapu API — offramp Lightning -> ARS
# Obtené tu API key en https://wapu.shiafu.com
# Para hackathon podés usar el CLI directamente sin API key
# ============================================================================
WAPU_API_URL="https://be-prod.wapu.app"
WAPU_API_KEY=""

# Modo de Wapu: "real" usa la API, "mock" simula los retiros (para demo segura)
WAPU_MODE="mock"

# ============================================================================
# Tasa BTC/ARS — fuente de precio
# Yadio es gratis y sin API key. Buena para Argentina.
# ============================================================================
PRICE_FEED_URL="https://api.yadio.io/exrates/BTC"

# ============================================================================
# Modo demo — muestra un botón "simular pago" en el checkout.
# Se ignora automáticamente si WAPU_MODE="real".
# ============================================================================
DEMO_MODE="true"
